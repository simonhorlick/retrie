# Unfolding a function of arity greater than two used in backtick
# form. The fully applied shapes -- the parenthesized operator
# application given its remaining argument -- substitute completely;
# the sections eta-expand every unsupplied parameter. Before the fix
# no backtick rewrites were generated at all for such functions.
-u Backticks3.bar
===
 module Backticks3 where

 main :: IO ()
 main = do
-  print $ (1 `bar` 2) 3
+  print $ 1 + 2 * 3
-  print $ (foo `bar` 2) 4
+  print $ foo + 2 * 4
-  print $ (foo `bar`) 2 5
+  print $ (\ y z -> foo + y * z) 2 5
-  print $ (`bar` 2) foo 6
+  print $ (\ x z -> x + 2 * z) foo 6

 foo :: Int
 foo = 100

 bar :: Int -> Int -> Int -> Int
 bar x y z = x + y * z
