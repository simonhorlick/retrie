# Unfolding a function of arity greater than two used in backtick
# form.
-u Backticks3.bar
-u Backticks3.baz
===
 module Backticks3 where

 main :: IO ()
 main = do
-  print $ (1 `bar` 2) 3
+  print $ 1 + 2 * 3
-  print $ (foo `bar` 2) 4
+  print $ foo + 2 * 4
-  print $ (foo `bar`) 2 5
+  print $ (\ y z -> foo + y * z) 2 5
-  print $ (`bar` 2) foo 6
+  print $ (\ x z -> x + 2 * z) foo 6
-  print $ (1 `baz` 2) 3 4
+  print $ 1 + 2 * 3 - 4

 foo :: Int
 foo = 100

 bar :: Int -> Int -> Int -> Int
 bar x y z = x + y * z

 baz :: Int -> Int -> Int -> Int -> Int
 baz x y z w = x + y * z - w
