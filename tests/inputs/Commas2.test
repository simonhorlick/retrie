# A hole bound to a comma-trailing list element, substituted back into a
# comma-trailing template position, must not print a duplicated comma.
--adhoc "forall a b. f [a, b] = g [a, b]"
===
 module Commas2 where

 main :: IO ()
-main = print (f [succ 1, 2])
+main = print (g [succ 1, 2])

 f :: [Int] -> [Int]
 f = id

 g :: [Int] -> [Int]
 g = id
