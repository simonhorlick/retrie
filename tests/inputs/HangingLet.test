#
# A hanging let (keyword ending its line, bindings and 'in' dedented
# left of it) must be re-laid when grafted at a column left of the
# original keyword, not printed with its bindings at column zero.
-u HangingLet.aConsiderablyLongName
===
 module HangingLet where

 main :: IO ()
-main = print aConsiderablyLongName
+main = print (let y = 5
+              in y + 1)

 aConsiderablyLongName :: Int
 aConsiderablyLongName = let
   y = 5
   in y + 1
